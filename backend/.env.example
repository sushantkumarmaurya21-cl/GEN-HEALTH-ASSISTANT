# HealthCare AI - Backend Environment Variables
# Copy this file to .env to configure your local environment:
# cp .env.example .env

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider Configuration
# Optional: Provide Google Gemini API Key or OpenAI API Key
# If left blank, the application automatically runs in "Demo Mode (Mock Simulation)"
# with safe, clearly marked educational responses.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Model selection (defaults to gemini-1.5-flash or gpt-4o-mini if keys are present)
AI_MODEL=gemini-1.5-flash

# SQLite Database path
DATABASE_URL=sqlite:///./healthcare_ai.db

# Rate Limiting (requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

